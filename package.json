{
  "name": "airoaming",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @airoaming/shared build && pnpm --filter @airoaming/server local:dev -- all",
    "dev:server": "pnpm --filter @airoaming/shared build && pnpm --filter @airoaming/server local:dev -- server",
    "dev:web": "pnpm --filter @airoaming/shared build && pnpm --filter @airoaming/web dev",
    "typecheck": "pnpm -r typecheck",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "pnpm -r --parallel --filter @airoaming/shared --filter @airoaming/server --filter @airoaming/web test",
    "test:e2e:env": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/e2e/support/*.test.ts",
    "test:e2e:prepare": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/e2e/support/e2e-prepare.contract.ts",
    "pretest:e2e": "pnpm test:e2e:prepare",
    "test:e2e": "node tests/e2e/support/run-e2e-matrix.mjs",
    "test:e2e:repeat": "pnpm test:e2e:prepare && node tests/e2e/support/run-e2e-matrix.mjs --repeat-each=3",
    "test:e2e:ui": "pnpm test:e2e:prepare && node tests/e2e/support/run-e2e-matrix.mjs --mode=file --ui",
    "test:e2e:ui:db": "pnpm test:e2e:prepare && node tests/e2e/support/run-e2e-matrix.mjs --mode=db --ui",
    "test:e2e:g5": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/g5/g5-gate-report.ts e2e",
    "g5:fixtures:generate": "node tests/fixtures/layout/generate-corpus.mjs",
    "test:g5:fixtures": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/g5/layout-fixture-contract.test.ts",
    "smart-layout:m0:generate": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/smart-layout/generate-corpus.ts",
    "smart-layout:m0:render": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/smart-layout/render-m0-baseline.ts",
    "smart-layout:m2:render": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/smart-layout/render-m2-rule-composition.ts",
    "smart-layout:m3:render": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/smart-layout/render-m3-visual-composition.ts",
    "smart-layout:m3:generate": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/fixtures/smart-layout/generate-m3-visual-analysis.ts",
    "smart-layout:m3:review:render": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/smart-layout/render-m3-human-review-v2.ts",
    "smart-layout:m3:review:validate": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/smart-layout/validate-m3-human-reviews-v2.ts",
    "smart-layout:m3:review:legacy:validate": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/smart-layout/validate-m3-human-reviews.ts",
    "test:smart-layout:m0": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/smart-layout/m0-*.test.ts",
    "test:smart-layout:m1": "pnpm --filter @airoaming/shared exec vitest run src/layout/automation.spec.ts src/layout/commands-v2.spec.ts",
    "test:smart-layout:m2": "pnpm --filter @airoaming/shared exec vitest run src/layout/dialogue.spec.ts src/layout/narrative.spec.ts src/layout/rule-composer.spec.ts && node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/smart-layout/m2-rule-composition-artifact.test.ts",
    "test:smart-layout:m3": "pnpm --filter @airoaming/shared exec vitest run src/layout/visual-analysis.spec.ts src/layout/visual-composer.spec.ts && node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/smart-layout/m3-*.test.ts",
    "test:render": "pnpm test:g5:fixtures && node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/g5/g5-gate-report.ts render",
    "test:migration:g5": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/g5/g5-gate-report.ts migration",
    "prototype:g5-e0": "pnpm --dir prototypes/layout-editor-e0 compare",
    "test:all": "pnpm typecheck && pnpm typecheck:e2e && pnpm test && pnpm test:e2e",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "pnpm --filter @airoaming/server exec prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "pnpm --filter @airoaming/server prisma:validate"
  },
  "devDependencies": {
    "@airoaming/shared": "workspace:*",
    "@playwright/test": "1.61.1",
    "tsx": "4.22.3",
    "typescript": "^5.6.3"
  }
}
