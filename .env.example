PORT=4310
AIROAMING_PERSISTENCE_MODE=db
# `pnpm dev` 默认使用以下稳定目录；如需覆盖，必须填写绝对路径。
# AIROAMING_DATA_ROOT=/absolute/path/to/.airoaming/data
# AIROAMING_WORKSPACE_ROOT=/absolute/path/to/.airoaming/workspace
# DATABASE_URL=file:/absolute/path/to/.airoaming/data/db/airoaming.sqlite
VITE_API_BASE_URL=/api
OPENCODE_PROVIDER_ID=self
OPENCODE_MODEL_ID=gpt-5.5
# Grok 图片默认使用 1K 以控制日常测试成本；正式高分辨率成稿可显式改为 2k。
GROK_IMAGE_RESOLUTION=1k
# Runware 密钥请在设置页保存，不要写入 .env.example 或提交到 Git。
RUNWARE_IMAGE_PROVIDER_ID=runware_image
RUNWARE_IMAGE_MODEL_ID=runware:100@1
RUNWARE_IMAGE_BASE_URL=https://api.runware.ai/v1
