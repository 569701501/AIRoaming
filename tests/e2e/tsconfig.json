{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../..",
    "paths": {
      "@airoaming/shared": ["packages/shared/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "typeRoots": ["../../apps/server/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "../../playwright.config.ts",
    "./**/*.ts",
    "./**/*.mjs"
  ]
}
