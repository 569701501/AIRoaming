  status                  String
  taskId                  String?   @map("task_id")
  layoutRevisionId        String?   @map("layout_revision_id")
  revisionDocumentDigest  String?   @map("revision_document_digest")
  visibleDocumentDigest   String?   @map("visible_document_digest")
  sourceLockSetDigest     String?   @map("source_lock_set_digest")
  profileJson             Json?     @map("profile_json")
  profileSchemaVersion    Int?      @map("profile_schema_version")
  profileDigest           String?   @map("profile_digest")
  preflightDigest         String?   @map("preflight_digest")
  rendererVersion         String?   @map("renderer_version")
  manifestJson            Json?     @map("manifest_json")
  manifestSchemaVersion   Int?      @map("manifest_schema_version")
  manifestDigest          String?   @map("manifest_digest")
  completionApplicability String?   @map("completion_applicability")
  origin                  String
  createdAt               DateTime  @default(now()) @map("created_at")
  readyAt                 DateTime? @map("ready_at")
  failedAt                DateTime? @map("failed_at")
  cancelledAt             DateTime? @map("cancelled_at")

  chaptersByCurrentExportRevision Chapter[]        @relation("Chapter_currentExportRevision_ExportRevision")
  exportArtifactsByExportRevision ExportArtifact[] @relation("ExportArtifact_exportRevision_ExportRevision")
  chapter                         Chapter?         @relation("ExportRevision_chapter_Chapter", fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  layoutRevision                  LayoutRevision?  @relation("ExportRevision_layoutRevision_LayoutRevision", fields: [layoutRevisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  project                         Project          @relation("ExportRevision_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  task                            GenerationTask?  @relation("ExportRevision_task_GenerationTask", fields: [taskId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, projectId, scopeKey], map: "uq_export_revisions_id_scope")
  @@unique([projectId, scopeKey, kind, revision], map: "uq_export_revisions_scope_kind_revision")
  @@unique([taskId], map: "uq_export_revisions_task")
  @@index([chapterId(sort: Asc), kind(sort: Asc), status(sort: Asc)], map: "ix_export_revisions_chapter_kind_status")
  @@index([layoutRevisionId(sort: Asc)], map: "ix_export_revisions_layout")
  @@map("export_revisions")
}

model ExportArtifact {
  id               String @id @default(uuid())
  exportRevisionId String @map("export_revision_id")
  assetId          String @map("asset_id")
  role             String
  order            Int

  asset          Asset          @relation("ExportArtifact_asset_Asset", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  exportRevision ExportRevision @relation("ExportArtifact_exportRevision_ExportRevision", fields: [exportRevisionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assetId], map: "uq_export_artifacts_asset")
  @@unique([exportRevisionId, role, order], map: "uq_export_artifacts_revision_role_order")
  @@map("export_artifacts")
}

model OutboxEvent {
  id                   String    @id @default(uuid())
  eventType            String    @map("event_type")
  aggregateType        String    @map("aggregate_type")
  aggregateId          String    @map("aggregate_id")
  payloadJson          Json      @map("payload_json")
  payloadSchemaVersion Int       @map("payload_schema_version")
  payloadDigest        String    @map("payload_digest")
  status               String    @default("pending")
  attempt              Int       @default(0)
  maxAttempts          Int       @default(3) @map("max_attempts")
  availableAt          DateTime  @default(now()) @map("available_at")
  leaseOwnerId         String?   @map("lease_owner_id")
  leaseToken           String?   @map("lease_token")
  leaseExpiresAt       DateTime? @map("lease_expires_at")
  lastErrorJson        Json?     @map("last_error_json")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  processedAt          DateTime? @map("processed_at")
  idempotencyKey       String    @map("idempotency_key")

  @@unique([idempotencyKey], map: "uq_outbox_events_idempotency_key")
  @@unique([leaseToken], map: "uq_outbox_events_lease_token")
  @@index([aggregateType(sort: Asc), aggregateId(sort: Asc)], map: "ix_outbox_events_aggregate")
  @@index([status(sort: Asc), availableAt(sort: Asc), createdAt(sort: Asc)], map: "ix_outbox_events_claim")
  @@index([status(sort: Asc), leaseExpiresAt(sort: Asc)], map: "ix_outbox_events_recovery")
  @@map("outbox_events")
}

model DocumentWork {
  id             String    @id @default(uuid())
  name           String
  kind           String    @default("text") @map("kind")
  status         String    @default("importing") @map("status")
  sourceStorageKey String  @map("source_storage_key")
  sourceSha256   String    @map("source_sha256")
  sourceBytes    Int       @map("source_bytes")
  sourceEncoding String?   @map("source_encoding")
  chapterCount   Int       @default(0) @map("chapter_count")
  unassignedCount Int      @default(0) @map("unassigned_count")
  importError    String?   @map("import_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  chapters DocumentChapter[] @relation("DocumentChapter_work_DocumentWork")

  @@index([status(sort: Asc), createdAt(sort: Asc)], map: "ix_document_works_status_created")
  @@map("document_works")
}

model DocumentChapter {
  id             String    @id @default(uuid())
  workId         String    @map("work_id")
  order          Int
  title          String
  groupLabel     String    @map("group_label")
  startOffset    Int       @map("start_offset")
  endOffset      Int       @map("end_offset")
  charCount      Int       @map("char_count")
  anomaliesJson  Json?     @map("anomalies_json")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  work DocumentWork @relation("DocumentChapter_work_DocumentWork", fields: [workId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workId, order], map: "uq_document_chapters_work_order")
  @@index([workId(sort: Asc), order(sort: Asc)], map: "ix_document_chapters_work_order")
  @@map("document_chapters")
}
