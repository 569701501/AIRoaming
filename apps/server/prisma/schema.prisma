generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PersistenceState {
  id                            String    @id @default("primary")
  storageContractVersion        Int       @default(1) @map("storage_contract_version")
  activationState               String    @default("shadow") @map("activation_state")
  cutoverRunId                  String?   @map("cutover_run_id")
  sourceManifestDigest          String?   @map("source_manifest_digest")
  effectiveSchemaManifestDigest String?   @map("effective_schema_manifest_digest")
  activatedAt                   DateTime? @map("activated_at")
  firstBusinessWriteAt          DateTime? @map("first_business_write_at")
  lastVerifiedAt                DateTime? @map("last_verified_at")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  cutoverRun MigrationRun? @relation("PersistenceState_cutoverRun_MigrationRun", fields: [cutoverRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("persistence_states")
}

model MigrationRun {
  id                        String    @id @default(uuid())
  kind                      String
  status                    String    @default("running")
  importerVersion           String    @map("importer_version")
  sourceManifestDigest      String    @map("source_manifest_digest")
  snapshotManifestDigest    String?   @map("snapshot_manifest_digest")
  decisionsDigest           String?   @map("decisions_digest")
  reportDigest              String?   @map("report_digest")
  countsJson                Json?     @map("counts_json")
  countsSchemaVersion       Int?      @map("counts_schema_version")
  verificationJson          Json?     @map("verification_json")
  verificationSchemaVersion Int?      @map("verification_schema_version")
  errorCode                 String?   @map("error_code")
  startedAt                 DateTime  @default(now()) @map("started_at")
  finishedAt                DateTime? @map("finished_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  importedEntitySourcesByFirstRun ImportedEntitySource[] @relation("ImportedEntitySource_firstRun_MigrationRun")
  importedEntitySourcesByLastRun  ImportedEntitySource[] @relation("ImportedEntitySource_lastRun_MigrationRun")
  migrationIssuesByRun            MigrationIssue[]       @relation("MigrationIssue_run_MigrationRun")
  persistenceStatesByCutoverRun   PersistenceState[]     @relation("PersistenceState_cutoverRun_MigrationRun")

  @@index([status(sort: Asc), startedAt(sort: Asc)], map: "ix_migration_runs_status_started_at")
  @@map("migration_runs")
}

model ImportedEntitySource {
  id               String   @id @default(uuid())
  sourceKey        String   @map("source_key")
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  sourceStorageKey String?  @map("source_storage_key")
  sourceDigest     String   @map("source_digest")
  payloadDigest    String?  @map("payload_digest")
  provenanceStatus String   @default("reference_only") @map("provenance_status")
  firstRunId       String   @map("first_run_id")
  lastRunId        String   @map("last_run_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  firstRun MigrationRun @relation("ImportedEntitySource_firstRun_MigrationRun", fields: [firstRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lastRun  MigrationRun @relation("ImportedEntitySource_lastRun_MigrationRun", fields: [lastRunId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([sourceKey], map: "uq_imported_entity_sources_source_key")
  @@index([entityType(sort: Asc), entityId(sort: Asc)], map: "ix_imported_entity_sources_entity")
  @@index([lastRunId(sort: Asc)], map: "ix_imported_entity_sources_last_run")
  @@map("imported_entity_sources")
}

model MigrationIssue {
  id                  String    @id @default(uuid())
  runId               String    @map("run_id")
  issueKey            String    @map("issue_key")
  severity            String
  code                String
  sourceKey           String?   @map("source_key")
  entityType          String?   @map("entity_type")
  entityId            String?   @map("entity_id")
  storageKey          String?   @map("storage_key")
  detailJson          Json      @map("detail_json")
  detailSchemaVersion Int       @map("detail_schema_version")
  resolutionStatus    String    @default("open") @map("resolution_status")
  resolutionJson      Json?     @map("resolution_json")
  resolvedAt          DateTime? @map("resolved_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  run MigrationRun @relation("MigrationIssue_run_MigrationRun", fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([runId, issueKey], map: "uq_migration_issues_run_issue_key")
  @@index([code(sort: Asc)], map: "ix_migration_issues_code")
  @@index([runId(sort: Asc), severity(sort: Asc)], map: "ix_migration_issues_run_severity")
  @@map("migration_issues")
}

model Project {
  id                     String    @id @default(uuid())
  name                   String
  type                   String    @default("comic")
  lifecycleStatus        String    @default("active") @map("lifecycle_status")
  storyTitle             String?   @map("story_title")
  genreTags              Json      @map("genre_tags")
  comicFormat            String    @map("comic_format")
  artStyle               String?   @map("art_style")
  description            String?
  currentChapterId       String?   @map("current_chapter_id")
  currentScriptOutlineId String?   @map("current_script_outline_id")
  rowVersion             Int       @default(0) @map("row_version")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletingAt             DateTime? @map("deleting_at")

  assetsByProject                         Asset[]                         @relation("Asset_project_Project")
  chapterScenesByProject                  ChapterScene[]                  @relation("ChapterScene_project_Project")
  chaptersByProject                       Chapter[]                       @relation("Chapter_project_Project")
  charactersByProject                     Character[]                     @relation("Character_project_Project")
  conversationThreadsByProject            ConversationThread[]            @relation("ConversationThread_project_Project")
  exportRevisionsByProject                ExportRevision[]                @relation("ExportRevision_project_Project")
  generationTasksByProject                GenerationTask[]                @relation("GenerationTask_project_Project")
  layoutCompositionApplicationsByProject  LayoutCompositionApplication[]  @relation("LayoutCompositionApplication_project_Project")
  layoutRevisionsByProject                LayoutRevision[]                @relation("LayoutRevision_project_Project")
  layoutWorkingCopysByProject             LayoutWorkingCopy[]             @relation("LayoutWorkingCopy_project_Project")
  pendingDialogueArtifactsByProject       PendingDialogueArtifact[]       @relation("PendingDialogueArtifact_project_Project")
  preflightRevisionsByProject             PreflightRevision[]             @relation("PreflightRevision_project_Project")
  projectContextFactsByProject            ProjectContextFact[]            @relation("ProjectContextFact_project_Project")
  projectScriptOutlinesByProject          ProjectScriptOutline[]          @relation("ProjectScriptOutline_project_Project")
  scriptChapterMapsByProject              ScriptChapterMap[]              @relation("ScriptChapterMap_project_Project")
  scriptImportAnalysisCandidatesByProject ScriptImportAnalysisCandidate[] @relation("ScriptImportAnalysisCandidate_project_Project")
  scriptImportBatchesByProject            ScriptImportBatch[]             @relation("ScriptImportBatch_project_Project")
  scriptRawSourceVersionsByProject        ScriptRawSourceVersion[]        @relation("ScriptRawSourceVersion_project_Project")
  currentChapter                          Chapter?                        @relation("Project_currentChapter_Chapter", fields: [currentChapterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentScriptOutline                    ProjectScriptOutline?           @relation("Project_currentScriptOutline_ProjectScriptOutline", fields: [currentScriptOutlineId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  shotsByProject                          Shot[]                          @relation("Shot_project_Project")
  storyVersionsByProject                  StoryVersion[]                  @relation("StoryVersion_project_Project")
  storyboardVersionsByProject             StoryboardVersion[]             @relation("StoryboardVersion_project_Project")

  @@index([lifecycleStatus(sort: Asc), updatedAt(sort: Asc)], map: "ix_projects_lifecycle_updated_at")
  @@map("projects")
}

model ProjectScriptOutline {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  version      Int
  status       String    @default("draft")
  title        String
  sourceText   String    @map("source_text")
  sourceDigest String    @map("source_digest")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  confirmedAt  DateTime? @map("confirmed_at")

  project                        Project   @relation("ProjectScriptOutline_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  projectsByCurrentScriptOutline Project[] @relation("Project_currentScriptOutline_ProjectScriptOutline")

  @@unique([id, projectId], map: "uq_project_script_outlines_id_project")
  @@unique([projectId, version], map: "uq_project_script_outlines_project_version")
  @@index([projectId(sort: Asc), status(sort: Asc)], map: "ix_project_script_outlines_project_status")
  @@map("project_script_outlines")
}

model Chapter {
  id                         String    @id @default(uuid())
  projectId                  String    @map("project_id")
  slug                       String
  order                      Int
  title                      String
  milestoneStatus            String    @default("draft") @map("milestone_status")
  scriptWorkingText          String    @default("") @map("script_working_text")
  scriptWorkingDigest        String    @map("script_working_digest")
  scriptWorkingState         String    @default("empty") @map("script_working_state")
  summary                    String?
  documentWorkId             String?   @map("document_work_id")
  documentChapterId          String?   @map("document_chapter_id")
  completedAt                DateTime? @map("completed_at")
  currentScriptVersionId     String?   @map("current_script_version_id")
  currentStoryVersionId      String?   @map("current_story_version_id")
  pendingStoryVersionId      String?   @map("pending_story_version_id")
  currentStoryboardVersionId String?   @map("current_storyboard_version_id")
  pendingStoryboardVersionId String?   @map("pending_storyboard_version_id")
  currentPreflightRevisionId String?   @map("current_preflight_revision_id")
  currentLayoutRevisionId    String?   @map("current_layout_revision_id")
  currentExportRevisionId    String?   @map("current_export_revision_id")
  lastScriptRevisionId       String?   @map("last_script_revision_id")
  rowVersion                 Int       @default(0) @map("row_version")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  assetsByChapter                   Asset[]                   @relation("Asset_chapter_Chapter")
  chapterScenesByChapter            ChapterScene[]            @relation("ChapterScene_chapter_Chapter")
  chapterScriptPendingByChapter     ChapterScriptPending?     @relation("ChapterScriptPending_chapter_Chapter")
  chapterScriptRevisionsByChapter   ChapterScriptRevision[]   @relation("ChapterScriptRevision_chapter_Chapter")
  chapterScriptVersionsByChapter    ChapterScriptVersion[]    @relation("ChapterScriptVersion_chapter_Chapter")
  currentExportRevision             ExportRevision?           @relation("Chapter_currentExportRevision_ExportRevision", fields: [currentExportRevisionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentLayoutRevision             LayoutRevision?           @relation("Chapter_currentLayoutRevision_LayoutRevision", fields: [currentLayoutRevisionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentPreflightRevision          PreflightRevision?        @relation("Chapter_currentPreflightRevision_PreflightRevision", fields: [currentPreflightRevisionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentScriptVersion              ChapterScriptVersion?     @relation("Chapter_currentScriptVersion_ChapterScriptVersion", fields: [currentScriptVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentStoryVersion               StoryVersion?             @relation("Chapter_currentStoryVersion_StoryVersion", fields: [currentStoryVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  currentStoryboardVersion          StoryboardVersion?        @relation("Chapter_currentStoryboardVersion_StoryboardVersion", fields: [currentStoryboardVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lastScriptRevision                ChapterScriptRevision?    @relation("Chapter_lastScriptRevision_ChapterScriptRevision", fields: [lastScriptRevisionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pendingStoryVersion               StoryVersion?             @relation("Chapter_pendingStoryVersion_StoryVersion", fields: [pendingStoryVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pendingStoryboardVersion          StoryboardVersion?        @relation("Chapter_pendingStoryboardVersion_StoryboardVersion", fields: [pendingStoryboardVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  project                           Project                   @relation("Chapter_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conversationThreadsByChapter      ConversationThread[]      @relation("ConversationThread_chapter_Chapter")
  exportRevisionsByChapter          ExportRevision[]          @relation("ExportRevision_chapter_Chapter")
  generationTasksByChapter          GenerationTask[]          @relation("GenerationTask_chapter_Chapter")
  layoutCompositionApplicationsByChapter LayoutCompositionApplication[] @relation("LayoutCompositionApplication_chapter_Chapter")
  layoutRevisionsByChapter          LayoutRevision[]          @relation("LayoutRevision_chapter_Chapter")
  layoutWorkingCopyByChapter        LayoutWorkingCopy?        @relation("LayoutWorkingCopy_chapter_Chapter")
  pendingDialogueArtifactsByChapter PendingDialogueArtifact[] @relation("PendingDialogueArtifact_chapter_Chapter")
  preflightRevisionsByChapter       PreflightRevision[]       @relation("PreflightRevision_chapter_Chapter")
  projectsByCurrentChapter          Project[]                 @relation("Project_currentChapter_Chapter")
  shotsByChapter                    Shot[]                    @relation("Shot_chapter_Chapter")
  storyVersionsByChapter            StoryVersion[]            @relation("StoryVersion_chapter_Chapter")
  storyboardVersionsByChapter       StoryboardVersion[]       @relation("StoryboardVersion_chapter_Chapter")
  scriptImportBatchItemsByChapter   ScriptImportBatchItem[]   @relation("ScriptImportBatchItem_chapter_Chapter")

  @@unique([id, projectId], map: "uq_chapters_id_project")
  @@unique([projectId, order], map: "uq_chapters_project_order")
  @@unique([projectId, slug], map: "uq_chapters_project_slug")
  @@index([projectId(sort: Asc), milestoneStatus(sort: Asc)], map: "ix_chapters_project_milestone")
  @@map("chapters")
}

model ChapterScriptVersion {
  id           String    @id @default(uuid())
  chapterId    String    @map("chapter_id")
  version      Int
  sourceText   String    @map("source_text")
  sourceDigest String    @map("source_digest")
  origin       String
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  chapter                                  Chapter                 @relation("ChapterScriptVersion_chapter_Chapter", fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  chaptersByCurrentScriptVersion           Chapter[]               @relation("Chapter_currentScriptVersion_ChapterScriptVersion")
  storyVersionsBySourceScriptVersion       StoryVersion[]          @relation("StoryVersion_sourceScriptVersion_ChapterScriptVersion")
  importBatchItemsByConfirmedScriptVersion ScriptImportBatchItem[] @relation("ScriptImportBatchItem_confirmedScriptVersion_ChapterScriptVersion")

  @@unique([chapterId, version], map: "uq_chapter_script_versions_chapter_version")
  @@unique([id, chapterId], map: "uq_chapter_script_versions_id_chapter")
  @@map("chapter_script_versions")
}

model ChapterScriptPending {
  id                   String    @id @default(uuid())
  chapterId            String    @map("chapter_id")
  sourceText           String    @map("source_text")
  sourceDigest         String    @map("source_digest")
  operation            String
  kind                 String    @default("legacy")
  sourcePolicyVersion  String?   @map("source_policy_version")
  sourceProjectionJson Json?     @map("source_projection_json")
  sourceSetDigest      String?   @map("source_set_digest")
  sourceSetSealedAt    DateTime? @map("source_set_sealed_at")
  threadId             String?   @map("thread_id")
  messageId            String?   @map("message_id")
  toolCallId           String?   @map("tool_call_id")
  rowVersion           Int       @default(0) @map("row_version")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  chapter        Chapter                             @relation("ChapterScriptPending_chapter_Chapter", fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  message        ConversationMessage?                @relation("ChapterScriptPending_message_ConversationMessage", fields: [messageId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  thread         ConversationThread?                 @relation("ChapterScriptPending_thread_ConversationThread", fields: [threadId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceBindings ChapterScriptPendingSourceBinding[] @relation("ChapterScriptPendingSourceBinding_pending_ChapterScriptPending")

  @@unique([chapterId], map: "uq_chapter_script_pending_chapter")
  @@index([threadId(sort: Asc), toolCallId(sort: Asc)], map: "ix_chapter_script_pending_thread_tool")
  @@map("chapter_script_pending")
}

model ScriptRawSourceVersion {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  version         Int
  schemaVersion   String   @map("schema_version")
  inputMode       String   @map("input_mode")
  contentTypeHint String   @map("content_type_hint")
  sourceDigest    String   @map("source_digest")
  documentCount   Int      @map("document_count")
  blockCount      Int      @map("block_count")
  createdAt       DateTime @default(now()) @map("created_at")

  project            Project                         @relation("ScriptRawSourceVersion_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  documents          ScriptRawSourceDocument[]       @relation("ScriptRawSourceDocument_rawSourceVersion_ScriptRawSourceVersion")
  blocks             ScriptRawSourceBlock[]          @relation("ScriptRawSourceBlock_rawSourceVersion_ScriptRawSourceVersion")
  analysisCandidates ScriptImportAnalysisCandidate[] @relation("ScriptImportAnalysisCandidate_rawSourceVersion_ScriptRawSourceVersion")
  chapterMaps        ScriptChapterMap[]              @relation("ScriptChapterMap_rawSourceVersion_ScriptRawSourceVersion")
  importBatches      ScriptImportBatch[]             @relation("ScriptImportBatch_rawSourceVersion_ScriptRawSourceVersion")

  @@unique([projectId, version], map: "uq_script_raw_source_versions_project_version")
  @@unique([projectId, sourceDigest], map: "uq_script_raw_source_versions_project_digest")
  @@unique([id, projectId], map: "uq_script_raw_source_versions_id_project")
  @@map("script_raw_source_versions")
}

model ScriptRawSourceDocument {
  id                 String   @id @default(uuid())
  rawSourceVersionId String   @map("raw_source_version_id")
  sourceRef          String   @map("source_ref")
  sourceOrder        Int      @map("source_order")
  sourceName         String   @map("source_name")
  mediaType          String   @map("media_type")
  sourceText         String   @map("source_text")
  sourceDigest       String   @map("source_digest")
  createdAt          DateTime @default(now()) @map("created_at")

  rawSourceVersion ScriptRawSourceVersion @relation("ScriptRawSourceDocument_rawSourceVersion_ScriptRawSourceVersion", fields: [rawSourceVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  blocks           ScriptRawSourceBlock[] @relation("ScriptRawSourceBlock_sourceDocument_ScriptRawSourceDocument")

  @@unique([rawSourceVersionId, sourceRef], map: "uq_script_raw_source_documents_version_ref")
  @@unique([rawSourceVersionId, sourceOrder], map: "uq_script_raw_source_documents_version_order")
  @@unique([id, rawSourceVersionId], map: "uq_script_raw_source_documents_id_version")
  @@map("script_raw_source_documents")
}

model ScriptRawSourceBlock {
  id                 String   @id @default(uuid())
  rawSourceVersionId String   @map("raw_source_version_id")
  sourceDocumentId   String   @map("source_document_id")
  sourceRef          String   @map("source_ref")
  blockRef           String   @map("block_ref")
  globalOrder        Int      @map("global_order")
  sourceOrder        Int      @map("source_order")
  locatorLabel       String   @map("locator_label")
  kind               String
  sourceText         String   @map("source_text")
  sourceDigest       String   @map("source_digest")
  createdAt          DateTime @default(now()) @map("created_at")

  rawSourceVersion ScriptRawSourceVersion  @relation("ScriptRawSourceBlock_rawSourceVersion_ScriptRawSourceVersion", fields: [rawSourceVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceDocument   ScriptRawSourceDocument @relation("ScriptRawSourceBlock_sourceDocument_ScriptRawSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([rawSourceVersionId, blockRef], map: "uq_script_raw_source_blocks_version_ref")
  @@unique([rawSourceVersionId, globalOrder], map: "uq_script_raw_source_blocks_version_global_order")
  @@unique([sourceDocumentId, sourceOrder], map: "uq_script_raw_source_blocks_document_order")
  @@map("script_raw_source_blocks")
}

model ScriptImportAnalysisCandidate {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  rawSourceVersionId String    @map("raw_source_version_id")
  version            Int
  status             String    @default("active")
  contractVersion    String    @map("contract_version")
  analysisJson       Json      @map("analysis_json")
  analysisDigest     String    @map("analysis_digest")
  validationJson     Json      @map("validation_json")
  validationDigest   String    @map("validation_digest")
  candidateDigest    String    @map("candidate_digest")
  sourceDigest       String    @map("source_digest")
  promptPackVersion  String    @map("prompt_pack_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")

  project          Project                @relation("ScriptImportAnalysisCandidate_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rawSourceVersion ScriptRawSourceVersion @relation("ScriptImportAnalysisCandidate_rawSourceVersion_ScriptRawSourceVersion", fields: [rawSourceVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  chapterMap       ScriptChapterMap?      @relation("ScriptChapterMap_analysisCandidate_ScriptImportAnalysisCandidate")

  @@unique([rawSourceVersionId, version], map: "uq_script_import_analysis_candidates_source_version")
  @@unique([id, projectId, rawSourceVersionId], map: "uq_script_import_analysis_candidates_scope")
  @@index([projectId(sort: Asc), status(sort: Asc)], map: "ix_script_import_analysis_candidates_project_status")
  @@map("script_import_analysis_candidates")
}

model ScriptChapterMap {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  rawSourceVersionId  String   @map("raw_source_version_id")
  analysisCandidateId String   @unique(map: "uq_script_chapter_maps_analysis_candidate") @map("analysis_candidate_id")
  version             Int
  schemaVersion       String   @map("schema_version")
  mapJson             Json     @map("map_json")
  mapDigest           String   @map("map_digest")
  sourceDigest        String   @map("source_digest")
  analysisDigest      String   @map("analysis_digest")
  confirmedAt         DateTime @map("confirmed_at")
  createdAt           DateTime @default(now()) @map("created_at")

  project           Project                       @relation("ScriptChapterMap_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rawSourceVersion  ScriptRawSourceVersion        @relation("ScriptChapterMap_rawSourceVersion_ScriptRawSourceVersion", fields: [rawSourceVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  analysisCandidate ScriptImportAnalysisCandidate @relation("ScriptChapterMap_analysisCandidate_ScriptImportAnalysisCandidate", fields: [analysisCandidateId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  importBatch       ScriptImportBatch?            @relation("ScriptImportBatch_chapterMap_ScriptChapterMap")

  @@unique([rawSourceVersionId, version], map: "uq_script_chapter_maps_source_version")
  @@unique([id, projectId, rawSourceVersionId], map: "uq_script_chapter_maps_scope")
  @@map("script_chapter_maps")
}

model ScriptImportBatch {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  rawSourceVersionId String    @map("raw_source_version_id")
  chapterMapId       String    @unique(map: "uq_script_import_batches_chapter_map") @map("chapter_map_id")
  status             String    @default("queued")
  inputDigest        String    @map("input_digest")
  rowVersion         Int       @default(0) @map("row_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project          Project                 @relation("ScriptImportBatch_project_Project", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rawSourceVersion ScriptRawSourceVersion  @relation("ScriptImportBatch_rawSourceVersion_ScriptRawSourceVersion", fields: [rawSourceVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  chapterMap       ScriptChapterMap        @relation("ScriptImportBatch_chapterMap_ScriptChapterMap", fields: [chapterMapId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items            ScriptImportBatchItem[] @relation("ScriptImportBatchItem_batch_ScriptImportBatch")

  @@unique([id, projectId], map: "uq_script_import_batches_id_project")
  @@index([projectId(sort: Asc), status(sort: Asc)], map: "ix_script_import_batches_project_status")
  @@map("script_import_batches")
}

model ScriptImportBatchItem {
  id                       String    @id @default(uuid())
  batchId                  String    @map("batch_id")
  chapterId                String    @map("chapter_id")
  mapItemRef               String    @map("map_item_ref")
  order                    Int
  status                   String    @default("queued")
  attempt                  Int       @default(0)
  sourceRangeDigest        String    @map("source_range_digest")
  outputDigest             String?   @map("output_digest")
  errorCode                String?   @map("error_code")
  errorJson                Json?     @map("error_json")
  confirmedScriptVersionId String?   @map("confirmed_script_version_id")
  rowVersion               Int       @default(0) @map("row_version")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  completedAt              DateTime? @map("completed_at")

  batch                  ScriptImportBatch            @relation("ScriptImportBatchItem_batch_ScriptImportBatch", fields: [batchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  chapter                Chapter                      @relation("ScriptImportBatchItem_chapter_Chapter", fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  confirmedScriptVersion ChapterScriptVersion?        @relation("ScriptImportBatchItem_confirmedScriptVersion_ChapterScriptVersion", fields: [confirmedScriptVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
